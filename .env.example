# MiniMax 月度订阅 API Key（Bearer 认证）
# 获取：minimax 开放平台 -> 账号设置
MINIMAX_API_KEY=your_minimax_api_key

# 火山引擎 Access Key / Secret Key（V4 签名，查询 Agent Plan 额度）
# 获取：火山引擎控制台 -> 右上角头像 -> 访问密钥
# 注意：不是 ark- 开头的 Bearer key（那个只能调模型，查不了 Agent Plan 额度）
VOLC_AK=your_volc_access_key
VOLC_SK=your_volc_secret_key

# 智谱 GLM Coding Plan（open.bigmodel.cn，Authorization raw token 鉴权）
ZHIPU_GLM_API_KEY=your_zhipu_glm_api_key

# OpenAI Codex（ChatGPT Plus/Pro 等订阅）使用量查询
# 接口：https://chatgpt.com/backend-api/usage
#
# 默认行为：自动读取本地 codex CLI 的登录态
#   路径：~/.codex/auth.json（或 ~/.config/codex/auth.json）
#   取值：tokens.access_token（ChatGPT OAuth 登录态）
#   如果你已经 `codex` 登录过 ChatGPT 订阅，无需任何额外配置即可使用。
#
# 回退方式：手动填入 access token 到下方
#   获取：浏览器登录 https://chatgpt.com → DevTools → Network 面板
#         → 任意请求头里的 Authorization Bearer 值，去掉 "Bearer " 前缀
#   仅在 codex CLI 未登录 / auth.json 缺失时生效。
#
# 适用条件：必须用 ChatGPT 订阅账号登录（Plus/Pro/Team/Edu/Enterprise），
#          仅用 OpenAI Platform API key 登录的 codex CLI 查不到 5h/7d 窗口。
CODEX_ACCESS_TOKEN=

# DeepSeek 开放平台余额查询
# 接口：https://api.deepseek.com/user/balance（Bearer 认证）
# 获取：DeepSeek 开放平台 -> 左侧 API keys -> 创建 API key
DEEPSEEK_API_KEY=your_deepseek_api_key

